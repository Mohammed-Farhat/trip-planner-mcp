# Copy to .env and fill in. .env is git-ignored.

# Required for the live agent (host/agent.py). The tests do not need it.
OPENAI_API_KEY=

# Optional: override the Agents SDK default model (openai-agents 0.24.0 defaults to gpt-5.6-luna).
# OPENAI_DEFAULT_MODEL=

# Optional: where save_trip stores trips (default: data/trips.json in the project folder).
# TRIPS_FILE=
